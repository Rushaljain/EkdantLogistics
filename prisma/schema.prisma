// Prisma Schema for Ekdant Logistics - Multi-Container & HazMat Document System
// Supports Multi-Invoice Ingestion, Container/Pallet Allocation, #DG & Master BOL Generation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ShipmentStatus {
  DRAFT
  EXTRACTED
  ALLOCATED
  DOCUMENTS_GENERATED
  COMPLETED
}

model Shipment {
  id                  String         @id @default(uuid())
  shipmentNumber      String         @unique // Internal Job e.g. EKD-2026-0089
  shipperName         String
  shipperAddress      String?
  consigneeName       String
  consigneeAddress    String?
  notifyParty         String?
  vesselName          String?
  voyageNumber        String?
  portOfLoading       String         @default("Nhava Sheva (INNSA1)")
  portOfDischarge     String         @default("Rotterdam (NLRTM)")
  placeOfDelivery     String?
  bookingNumber       String?
  masterBolNumber     String?
  hasDangerousGoods   Boolean        @default(false)
  status              ShipmentStatus @default(DRAFT)
  
  totalGrossWeightKg  Float          @default(0.0)
  totalNetWeightKg    Float          @default(0.0)
  totalPallets        Int            @default(0)
  totalPackages       Int            @default(0)
  
  invoices            Invoice[]
  containers          Container[]
  pallets             Pallet[]
  lineItems           LineItem[]
  documents           DocumentOutput[]
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Invoice {
  id           String     @id @default(uuid())
  shipmentId   String
  shipment     Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  invoiceNumber String
  invoiceDate  DateTime?
  currency     String     @default("USD")
  invoiceTotal Float      @default(0.0)
  subtotal     Float      @default(0.0)
  pdfFileName  String?
  lineItems    LineItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Container {
  id                 String     @id @default(uuid())
  shipmentId         String
  shipment           Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerNumber    String     // e.g. MSCU7829104
  sealNumber         String     // e.g. EMC883921
  containerType      String     @default("40HC") // 20GP, 40GP, 40HC, 45HC
  maxPayloadKg       Float      @default(26500.0)
  tareWeightKg       Float      @default(3900.0)
  totalGrossWeightKg Float      @default(0.0)
  totalNetWeightKg   Float      @default(0.0)
  totalPallets       Int        @default(0)
  totalPackages      Int        @default(0)
  isOverweight       Boolean    @default(false)
  hasDangerousGoods  Boolean    @default(false)
  pallets            Pallet[]
  lineItems          LineItem[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Pallet {
  id               String     @id @default(uuid())
  shipmentId       String
  shipment         Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerId      String?
  container        Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)
  palletNumber     String     // e.g. PLT-5644
  packageCount     Int        @default(1)
  packageType      String     @default("BOX") // CARTON, DRUM, CYLINDER, CRATE
  grossWeightKg    Float      @default(0.0)
  netWeightKg      Float      @default(0.0)
  dimensions       String?    // e.g. "120x80x160 cm"
  isDangerousGoods Boolean    @default(false)
  lineItems        LineItem[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model LineItem {
  id                 String     @id @default(uuid())
  shipmentId         String
  shipment           Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  containerId        String?
  container          Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)
  palletId           String?
  pallet             Pallet?    @relation(fields: [palletId], references: [id], onDelete: SetNull)
  
  itemNumber         Int
  description        String
  hsnCode            String?
  quantity           Float
  uqc                String     @default("PCS")
  unitPrice          Float      @default(0.0)
  total              Float      @default(0.0)
  netWeightKg        Float      @default(0.0)
  grossWeightKg      Float      @default(0.0)
  
  // Dangerous Goods attributes
  isDangerousGood    Boolean    @default(false)
  imoClass           String?    // e.g. "Class 3", "Class 8", "Class 9"
  unNumber           String?    // e.g. "UN 1993", "UN 1263"
  packingGroup       String?    // "I", "II", "III"
  properShippingName String?    // e.g. "FLAMMABLE LIQUID, N.O.S."
  flashPoint         String?    // e.g. "23°C c.c."
  marinePollutant    Boolean    @default(false)
  emergencyContact   String?
  
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Template {
  id               String     @id @default(uuid())
  name             String     // e.g. "Standard Ocean BOL", "IMO Dangerous Goods Declaration"
  type             String     // "BOL", "DG"
  carrierOrClient  String     @default("Standard")
  isDefault        Boolean    @default(false)
  contentLayout    String?    // JSON metadata or layout config
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model DocumentOutput {
  id                 String     @id @default(uuid())
  shipmentId         String
  shipment           Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documentType       String     // "BOL", "DG"
  documentNumber     String     // e.g. "BOL-EKD-2026-089"
  templateName       String
  containersSummary  String?
  generatedContent   String
  generatedAt        DateTime   @default(now())
}
