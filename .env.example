# Ekdant Logistics - Environment Configuration
# Copy this file to .env and provide your actual API keys

# Google Gemini Vision Extraction (gemini-2.5-flash / gemini-1.5-flash)
# Can also be entered securely directly into the app's Operator Settings UI!
VITE_GEMINI_API_KEY=""

# Supabase Storage, Auth, and PostgreSQL Database
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Prisma PostgreSQL Direct Connection (Supabase Transaction Pooler / Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
